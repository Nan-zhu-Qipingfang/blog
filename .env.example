# ─────────────────────────────────────────────────────────────────────────────
# Devosfera — Environment Variables
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit personal data to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── Social links (profile sidebar & footer) ───────────────────────────────
# Leave any of these empty (or remove the line) to hide that social link.

PUBLIC_SOCIAL_X=https://x.com/your-handle
PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/your-profile
PUBLIC_SOCIAL_EMAIL=your@email.com

# ── "Edit this post" button ────────────────────────────────────────────────
# Full URL prefix to your repo's edit page. The post file path is appended automatically.
# Example for GitHub: https://github.com/your-username/your-repo/edit/main/
PUBLIC_EDIT_POST_URL=https://github.com/your-username/your-repo/edit/main/

# ── Google Search Console verification (optional) ─────────────────────────
# PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token

# Admin save -> auto rebuild (Vercel Deploy Hook URL, optional)
DEPLOY_HOOK_URL=

# ── 后台管理（服务端私有，绝不要加 PUBLIC_ 前缀）────────────────────────
# 后台登录用户名，留空则默认 admin
ADMIN_USER=admin
# 后台登录密码。线上必须在 Vercel → Settings → Environment Variables 里配置，
# 否则任何人、包括你自己都登不进去（源码内已不再保留任何默认密码）
ADMIN_PASSWORD=
# 会话签名密钥（任意长随机字符串，可用 openssl rand -hex 32 生成）。
# 不配置的话每个 Serverless 实例冷启动都会随机生成一个，表现为"登录成功但一刷新就掉线"
ADMIN_SECRET=
