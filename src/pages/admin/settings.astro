---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import { isAuthed } from "@/utils/adminAuth";

// Server-side guard (Astro.redirect only works at page level)
if (!(await isAuthed(Astro.cookies))) {
  return Astro.redirect("/admin/login");
}
import { passwordSource } from "@/utils/adminAuth";
import { kvEnabled, kvProbe, kvStatus } from "@/utils/kvStore";
import { deployHookConfigured } from "@/utils/redeploy";
import { getAiConfig, getUsageStats, PRESETS } from "@/utils/aiSummary";

const source = await passwordSource();
const sourceText: Record<typeof source, string> = {
  hash: "当前使用自定义密码（已持久化保存）",
  env: "当前使用环境变量 ADMIN_PASSWORD 中配置的密码",
  none: "尚未配置任何密码：请在 .env 或部署平台的环境变量中设置 ADMIN_PASSWORD，否则将无法登录",
};

// Vercel's filesystem is read-only — without KV every write (import, save,
// logs) fails. Surface it here so the cause is obvious.
const storageOk = kvEnabled;
const missingVars = [
  !kvStatus.url && !kvStatus.redisUrlUsable && "KV_REST_API_URL（或 UPSTASH_REDIS_REST_URL）",
  !kvStatus.token && !kvStatus.redisUrlUsable && "KV_REST_API_TOKEN（或 UPSTASH_REDIS_REST_TOKEN）",
  !kvStatus.redisUrlUsable && "REDIS_URL（任意 Redis，走 TCP 直连）",
].filter(Boolean);

const storageText = storageOk
  ? kvStatus.transport === "tcp"
    ? "Redis 已启用（TCP 直连 REDIS_URL）：文章、日志正常持久化，保存后会自动触发重新部署。"
    : "KV 存储已启用（Upstash REST）：文章、日志正常持久化，保存后会自动触发重新部署。"
  : `未检测到可用的 Redis 环境变量：${missingVars.join("、")}。二选一即可——Upstash 系填 KV_REST_API_URL + KV_REST_API_TOKEN，其他 Redis（如 Redis Cloud）填 REDIS_URL。添加后必须点击一次 Redeploy，已部署的函数实例不会自动刷新环境变量。`;

// Diagnostics: which storage-related env var NAMES are actually visible to the
// running function (values are never printed). This settles "I connected the
// database but it still says KV is off" — either the names differ, or the
// variable is scoped to a different Vercel environment.
const envDiagnostics = {
  vercel: process.env.VERCEL ? "是" : "否",
  vercelEnv: process.env.VERCEL_ENV || "(空)",
  region: process.env.VERCEL_REGION || "(空)",
  transport: kvStatus.transport,
  deployHook: deployHookConfigured() ? "已配置" : "未配置",
  source: kvStatus.source,
  endpoint: kvStatus.endpoint,
  seen: Object.keys(process.env)
    .filter(k => /kv|upstash|redis|storage/i.test(k))
    .sort(),
};

// A real round-trip (set/get/del) — proves the REST endpoint works.
const probe = await kvProbe();

const inputClass =
  "w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm outline-none transition-colors focus:border-accent/60";

const aiConfig = await getAiConfig();
const aiUsage = await getUsageStats();
const aiPresets = Object.entries(PRESETS).map(([id, p]) => ({
  id,
  label: p.label,
  authMode: p.authMode,
}));
---

<AdminLayout>
  <div class="mx-auto max-w-2xl">
    <header class="mb-6">
      <h1 class="text-xl font-extrabold">设置</h1>
      <p class="mt-1 text-sm text-foreground/50">后台账号与运行说明</p>
    </header>

    <section class="bg-card/60 rounded-2xl border border-border/60 p-5">
      <h2 class="mb-1 text-sm font-bold">修改管理员密码</h2>
      <p class="mb-4 text-xs text-foreground/45">{sourceText[source]}</p>
      <form id="password-form" class="flex max-w-sm flex-col gap-3">
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-foreground/60"
            >旧密码</span
          >
          <input
            name="oldPassword"
            type="password"
            required
            class={inputClass}
            autocomplete="current-password"
          />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-foreground/60"
            >新密码（至少 6 位）</span
          >
          <input
            name="newPassword"
            type="password"
            required
            minlength="6"
            class={inputClass}
            autocomplete="new-password"
          />
        </label>
        <p id="password-status" class="hidden rounded-lg px-3 py-2 text-xs"></p>
        <button
          type="submit"
          class="mt-1 cursor-pointer self-start rounded-xl bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-all hover:opacity-90 active:scale-[0.98]"
        >
          更新密码
        </button>
      </form>
    </section>

    <section class="bg-card/60 mt-4 rounded-2xl border border-border/60 p-5">
      <h2 class="mb-1 text-sm font-bold">数据存储状态</h2>
      <p class="mt-2 flex items-start gap-2 text-xs">
        <span
          class:list={[
            "mt-1 inline-block h-2 w-2 shrink-0 rounded-full",
            storageOk ? "bg-emerald-500" : "bg-red-500",
          ]}></span>
        <span class={storageOk ? "text-foreground/55" : "text-red-500/90"}
          >{storageText}</span
        >
      </p>
      <dl
        class="mt-3 grid gap-1.5 border-t border-border/40 pt-3 text-xs text-foreground/45"
      >
        <div class="flex gap-2">
          <dt class="shrink-0">运行在 Vercel：</dt>
          <dd>
            {envDiagnostics.vercel}（VERCEL_ENV={
              envDiagnostics.vercelEnv
            }，区域{" "}
            {envDiagnostics.region}）
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="shrink-0">传输方式：</dt>
          <dd>
            {envDiagnostics.transport === "rest"
              ? "REST（Upstash HTTP）"
              : envDiagnostics.transport === "tcp"
                ? "TCP 直连（ioredis）"
                : "无（回落到本地文件）"}
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="shrink-0">凭证来源：</dt>
          <dd class="break-all">{envDiagnostics.source}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="shrink-0">端点：</dt>
          <dd class="break-all">{envDiagnostics.endpoint}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="shrink-0">读写自检：</dt>
          <dd class={probe.ok ? "text-emerald-600" : "text-red-500/90"}>
            {probe.ok ? "通过（写入/读取/删除均正常）" : `失败：${probe.error}`}
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="shrink-0">自动重新部署：</dt>
          <dd class={envDiagnostics.deployHook === "已配置" ? "text-emerald-600" : "text-red-500/90"}>
            {envDiagnostics.deployHook === "已配置"
              ? "已配置 DEPLOY_HOOK_URL，保存/导入后约 1 分钟前台生效"
              : "未配置 DEPLOY_HOOK_URL：文章已保存，但前台要等下次 Git 推送或手动 Redeploy 才更新"}
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="shrink-0">可见的存储类变量：</dt>
          <dd class="break-all">
            {
              envDiagnostics.seen.length
                ? envDiagnostics.seen.join("、")
                : "（一个都没有）"
            }
          </dd>
        </div>
      </dl>
    </section>

    <section class="bg-card/60 mt-4 rounded-2xl border border-border/60 p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-sm font-bold">AI 摘要</h2>
        <label class="flex cursor-pointer items-center gap-2 text-xs text-foreground/60">
          <input
            id="ai-enabled"
            type="checkbox"
            class="size-4 accent-[var(--accent)]"
            checked={aiConfig.enabled}
          />
          启用线上 AI 生成
        </label>
      </div>
      <p class="mt-2 text-xs leading-relaxed text-foreground/45">
        开启后，在「撰写文章」保存时会弹出「是否生成 AI 摘要」，可选择
        <strong class="font-semibold text-foreground/60">线上生成</strong>（调用下面配置的接口）或
        <strong class="font-semibold text-foreground/60">线下手写</strong>。
        摘要会写进文章 frontmatter 的 <code class="font-firacode text-accent/80">summary</code>
        字段，静态构建不再重复调用接口。
      </p>

      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-foreground/60">接口预设</span>
          <select id="ai-preset" class={inputClass}>
            {
              aiPresets.map(p => (
                <option value={p.id} selected={aiConfig.preset === p.id}>
                  {p.label}
                </option>
              ))
            }
            <option value="custom" selected={aiConfig.preset === "custom"}>
              自定义（手写模板）
            </option>
          </select>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-foreground/60">模型名</span>
          <input
            id="ai-model"
            type="text"
            class={inputClass + " font-firacode"}
            value={aiConfig.model}
            placeholder="gemini-3.1-pro"
          />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-foreground/60">鉴权方式</span>
          <select id="ai-auth" class={inputClass}>
            {
              [
                ["bearer", "Authorization: Bearer"],
                ["x-goog-api-key", "x-goog-api-key"],
                ["query-key", "URL 查询参数 ?key="],
                ["none", "不需要鉴权"],
              ].map(([v, label]) => (
                <option value={v} selected={aiConfig.authMode === v}>
                  {label}
                </option>
              ))
            }
          </select>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-foreground/60">API Key</span>
          <input
            id="ai-key"
            type="password"
            class={inputClass + " font-firacode"}
            placeholder={aiConfig.apiKey ? aiConfig.apiKey : "sk-…"}
            value=""
          />
        </label>
      </div>

      <label class="mt-3 block">
        <span class="mb-1.5 block text-xs font-medium text-foreground/60"
          >请求地址 URL（可含 <code class="font-firacode text-accent/80">{"{{model}}"}</code>
          占位，Gemini 原生接口需占位）</span
        >
        <input
          id="ai-url"
          type="text"
          class={inputClass + " font-firacode"}
          value={aiConfig.apiUrl}
          placeholder="https://your-gateway.example.com/v1/chat/completions"
        />
      </label>

      <label class="mt-3 block">
        <span class="mb-1.5 block text-xs font-medium text-foreground/60"
          >请求体模板（JSON，用 <code class="font-firacode text-accent/80">{"{{content}}"}</code>
          和 <code class="font-firacode text-accent/80">{"{{model}}"}</code> 占位）</span
        >
        <textarea
          id="ai-template"
          rows="9"
          spellcheck="false"
          class={inputClass + " resize-y font-firacode text-xs leading-relaxed"}
        >{aiConfig.requestTemplate}</textarea>
      </label>

      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-foreground/60">响应解析路径</span>
          <input
            id="ai-response"
            type="text"
            class={inputClass + " font-firacode text-xs"}
            value={aiConfig.responsePath}
            placeholder="choices[0].message.content"
          />
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="mb-1.5 block text-xs font-medium text-foreground/60">Prompt token 路径</span>
            <input
              id="ai-usage-p"
              type="text"
              class={inputClass + " font-firacode text-xs"}
              value={aiConfig.usagePromptPath}
              placeholder="usage.prompt_tokens"
            />
          </label>
          <label class="block">
            <span class="mb-1.5 block text-xs font-medium text-foreground/60">Completion 路径</span>
            <input
              id="ai-usage-c"
              type="text"
              class={inputClass + " font-firacode text-xs"}
              value={aiConfig.usageCompletionPath}
              placeholder="usage.completion_tokens"
            />
          </label>
        </div>
      </div>

      <div class="mt-3 grid grid-cols-3 gap-3">
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-foreground/60">正文 token 预算</span>
          <input
            id="ai-budget"
            type="number"
            min="200"
            max="200000"
            step="100"
            class={inputClass + " font-firacode"}
            value={String(aiConfig.maxInputTokens)}
          />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-foreground/60">输出上限</span>
          <input
            id="ai-maxout"
            type="number"
            min="16"
            max="4096"
            step="10"
            class={inputClass + " font-firacode"}
            value={String(aiConfig.maxOutputTokens)}
          />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-medium text-foreground/60">温度</span>
          <input
            id="ai-temp"
            type="number"
            min="0"
            max="2"
            step="0.1"
            class={inputClass + " font-firacode"}
            value={String(aiConfig.temperature)}
          />
        </label>
      </div>

      <label class="mt-3 block">
        <span class="mb-1.5 block text-xs font-medium text-foreground/60">摘要风格（prompt）</span>
        <textarea
          id="ai-system"
          rows="2"
          class={inputClass + " resize-y text-xs leading-relaxed"}
        >{aiConfig.systemPrompt}</textarea>
      </label>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <button
          id="ai-save"
          type="button"
          class="cursor-pointer rounded-xl bg-accent px-4 py-1.5 text-xs font-semibold text-white transition-all hover:opacity-90 active:scale-[0.98]"
        >
          保存 AI 配置
        </button>
        <button
          id="ai-test"
          type="button"
          class="cursor-pointer rounded-xl border border-border px-4 py-1.5 text-xs font-medium transition-colors hover:border-accent/40 hover:text-accent"
        >
          测试连接
        </button>
        <span id="ai-status" class="hidden rounded-lg px-3 py-1.5 text-xs"></span>
      </div>

      <div class="mt-4 border-t border-border/40 pt-3">
        <div class="mb-2 flex items-center justify-between gap-2">
          <span class="text-xs font-semibold text-foreground/60">Token 用量</span>
          <span class="font-firacode text-[11px] text-foreground/40"
            >累计 {aiUsage.calls} 次调用（线上 {aiUsage.onlineCalls} · 线下 {aiUsage.manualCalls}）</span
          >
        </div>
        <dl
          id="ai-usage"
          class="grid gap-1.5 text-xs text-foreground/45 sm:grid-cols-2"
          data-calls={String(aiUsage.calls)}
        >
          <div class="flex gap-2">
            <dt class="shrink-0">累计 Prompt：</dt>
            <dd class="font-firacode" data-usage="prompt">{aiUsage.promptTokens}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="shrink-0">累计 Completion：</dt>
            <dd class="font-firacode" data-usage="completion">{aiUsage.completionTokens}</dd>
          </div>
        </dl>
        {
          (() => {
            const lines: string[] = [];
            if (aiUsage.estimated) {
              lines.push("注：接口未返回 usage，以上 token 为中英混排启发式估算值");
            }
            const last = aiUsage.last;
            if (last) {
              lines.push(
                `最近一次：${last.source === "manual" ? "线下手写" : "线上生成"} · ${last.model} · ` +
                  `prompt ${last.promptTokens} / completion ${last.completionTokens} · ${last.latencyMs}ms`
              );
              if (last.ok === false && last.note) lines.push(`失败原因：${last.note}`);
            }
            return (
              <p
                id="ai-usage-note"
                class="mt-2 whitespace-pre-line text-[11px] leading-relaxed text-foreground/40"
              >
                {lines.join("\n")}
              </p>
            );
          })()
        }
      </div>
    </section>

    <section class="bg-card/60 mt-4 rounded-2xl border border-border/60 p-5">
      <h2 class="mb-1 text-sm font-bold">快捷导航配置（指纹菜单）</h2>
      <p class="mb-4 text-xs text-foreground/45">
        首页顶栏指纹图标弹出的快捷导航（如云盘、相册），保存后前台点击时即时生效。
      </p>
      <div id="links-rows" class="flex flex-col gap-2"></div>
      <div class="mt-3 flex items-center gap-3">
        <button
          id="add-link"
          type="button"
          class="cursor-pointer rounded-xl border border-border px-3 py-1.5 text-xs font-medium transition-colors hover:border-accent/40 hover:text-accent"
        >
          + 添加一项
        </button>
        <button
          id="save-links"
          type="button"
          class="cursor-pointer rounded-xl bg-accent px-4 py-1.5 text-xs font-semibold text-white transition-all hover:opacity-90 active:scale-[0.98]"
        >
          保存导航
        </button>
        <span id="links-status" class="hidden rounded-lg px-3 py-1.5 text-xs"
        ></span>
      </div>
    </section>

    <section class="bg-card/60 mt-4 rounded-2xl border border-border/60 p-5">
      <h2 class="mb-2 text-sm font-bold">关于本后台</h2>
      <ul
        class="flex flex-col gap-2 text-xs leading-relaxed text-foreground/55"
      >
        <li>
          · 前台保持纯静态输出，仅 <code class="font-firacode">/admin</code> 与 <code
            class="font-firacode">/api/admin/*</code
          > 走 Node 服务端按需渲染（@astrojs/node，standalone 模式）。
        </li>
        <li>
          · 文章即 <code class="font-firacode">src/data/blog/*.md</code
          >，后台的增删改直接读写这些文件；开发模式下前台即时热更新，生产部署后需重新构建。
        </li>
        <li>
          · 删除的文章移入 <code class="font-firacode"
            >src/data/admin/trash/</code
          >，可手动找回。
        </li>
        <li>
          · 会话凭据为 HttpOnly Cookie（HMAC 签名，7 天有效），密钥自动生成于 <code
            class="font-firacode">src/data/admin/secret.key</code
          >，也可用环境变量 <code class="font-firacode">ADMIN_SECRET</code> 固定。
        </li>
        <li>
          · 灵感来自《近期开发的四个开源项目》中 hubProxy / Artalk
          的后台设计：仪表盘、日志、设置集中管理。
        </li>
      </ul>
    </section>
  </div>
</AdminLayout>

<script>
  document
    .getElementById("password-form")
    ?.addEventListener("submit", async event => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const status = document.getElementById("password-status");
      const data = new FormData(form);
      const response = await fetch("/api/admin/password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          oldPassword: data.get("oldPassword"),
          newPassword: data.get("newPassword"),
        }),
      });
      const result = await response.json();
      if (status) {
        status.textContent = result.ok
          ? "✓ 密码已更新，下次登录生效"
          : (result.message ?? "修改失败");
        status.classList.remove("hidden");
        status.className = `rounded-lg px-3 py-2 text-xs ${result.ok ? "bg-green-500/10 text-green-600 dark:text-green-400" : "bg-red-500/10 text-red-500"}`;
      }
      if (result.ok) form.reset();
    });

  /* ── Portal quick links (fingerprint menu) ─────────────────────────── */

  const linksRows = document.getElementById("links-rows");
  const linksStatus = document.getElementById("links-status");

  function linkRow(name = "", url = ""): HTMLElement {
    const row = document.createElement("div");
    row.className = "flex items-center gap-2";
    row.innerHTML = `
      <input name="link-name" placeholder="名称（如：云盘）" value="${name}" class="w-32 rounded-xl border border-border bg-background px-3 py-2 text-sm outline-none transition-colors focus:border-accent/60" />
      <input name="link-url" placeholder="https://…" value="${url}" class="flex-1 rounded-xl border border-border bg-background px-3 py-2 font-firacode text-sm outline-none transition-colors focus:border-accent/60" />
      <button type="button" data-remove class="cursor-pointer rounded-lg px-2 py-1 text-xs text-red-500/70 transition-colors hover:bg-red-500/10 hover:text-red-500">删除</button>
    `;
    row
      .querySelector("[data-remove]")
      ?.addEventListener("click", () => row.remove());
    return row;
  }

  async function loadLinks() {
    const res = await fetch("/api/admin/links");
    if (res.status === 401) {
      location.href = "/admin/login";
      return;
    }
    const j = await res.json();
    if (linksRows) {
      linksRows.innerHTML = "";
      (j.links ?? []).forEach((l: { name: string; url: string }) =>
        linksRows.appendChild(linkRow(l.name, l.url))
      );
    }
  }

  document.getElementById("add-link")?.addEventListener("click", () => {
    linksRows?.appendChild(linkRow());
  });

  document.getElementById("save-links")?.addEventListener("click", async () => {
    const names = [
      ...(linksRows?.querySelectorAll("[name=link-name]") ?? []),
    ] as HTMLInputElement[];
    const urls = [
      ...(linksRows?.querySelectorAll("[name=link-url]") ?? []),
    ] as HTMLInputElement[];
    const links = names
      .map((n, i) => ({
        name: n.value.trim(),
        url: (urls[i]?.value ?? "").trim(),
      }))
      .filter(l => l.name && l.url);
    const res = await fetch("/api/admin/links", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ links }),
    });
    const j = await res.json();
    if (linksStatus) {
      linksStatus.textContent = j.ok
        ? "✓ 已保存，前台点击指纹图标即可看到"
        : (j.error ?? "保存失败");
      linksStatus.classList.remove("hidden");
      linksStatus.className = `rounded-lg px-3 py-1.5 text-xs ${j.ok ? "bg-green-500/10 text-green-600 dark:text-green-400" : "bg-red-500/10 text-red-500"}`;
      window.setTimeout(() => linksStatus.classList.add("hidden"), 3000);
    }
  });

  loadLinks();

  /* ── AI 摘要配置：保存 + 可达性测试 ─────────────────────── */

  const aiStatus = document.getElementById("ai-status");
  const aiBox = document.getElementById("ai-usage");

  function aiSay(text: string, ok: boolean) {
    if (!aiStatus) return;
    aiStatus.textContent = text;
    aiStatus.classList.remove("hidden");
    aiStatus.className = `rounded-lg px-3 py-1.5 text-xs ${ok ? "bg-green-500/10 text-green-600 dark:text-green-400" : "bg-red-500/10 text-red-500"}`;
  }

  function collectAi() {
    const val = (id: string) => document.getElementById(id) as HTMLInputElement;
    return {
      enabled: val("ai-enabled").checked,
      preset: val("ai-preset").value,
      model: val("ai-model").value.trim(),
      authMode: val("ai-auth").value,
      apiUrl: val("ai-url").value.trim(),
      apiKey: val("ai-key").value.trim(),
      requestTemplate: val("ai-template").value,
      responsePath: val("ai-response").value.trim(),
      usagePromptPath: val("ai-usage-p").value.trim(),
      usageCompletionPath: val("ai-usage-c").value.trim(),
      maxInputTokens: Number(val("ai-budget").value) || 6000,
      maxOutputTokens: Number(val("ai-maxout").value) || 220,
      temperature: Number(val("ai-temp").value),
      systemPrompt: val("ai-system").value.trim(),
    };
  }

  /** 用量面板：接口会回传最新统计，顺手把页面上的数字刷新掉。 */
  function paintAiUsage(usage: any) {
    if (!usage || !aiBox) return;
    const promptEl = aiBox.querySelector('[data-usage="prompt"]');
    const completionEl = aiBox.querySelector('[data-usage="completion"]');
    if (promptEl) promptEl.textContent = String(usage.promptTokens ?? 0);
    if (completionEl) completionEl.textContent = String(usage.completionTokens ?? 0);
    document.getElementById("ai-usage")?.setAttribute("data-calls", String(usage.calls ?? 0));

    const note = document.getElementById("ai-usage-note");
    if (!note) return;
    const lines: string[] = [];
    lines.push(
      `累计 ${usage.calls ?? 0} 次调用（线上 ${usage.onlineCalls ?? 0} · 线下 ${usage.manualCalls ?? 0}）`
    );
    if (usage.estimated) {
      lines.push("注：接口未返回 usage，以上 token 为中英混排启发式估算值");
    }
    const last = usage.last;
    if (last) {
      lines.push(
        `最近一次：${last.source === "manual" ? "线下手写" : "线上生成"} · ${last.model} · ` +
          `prompt ${last.promptTokens} / completion ${last.completionTokens} · ${last.latencyMs}ms`
      );
      if (last.ok === false && last.note) lines.push(`失败原因：${last.note}`);
    }
    note.textContent = lines.join("\n");
    note.classList.remove("hidden");
    note.style.whiteSpace = "pre-line";
  }

  document.getElementById("ai-save")?.addEventListener("click", async () => {
    aiSay("保存中…", true);
    try {
      const res = await fetch("/api/admin/ai/config", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(collectAi()),
      });
      const j = await res.json();
      if (!j.ok) {
        aiSay(j.error ?? "保存失败", false);
        return;
      }
      // 空输入或掩码值都不会覆盖已保存的真 key，这里只复位输入框
      const keyInput = document.getElementById("ai-key") as HTMLInputElement | null;
      if (keyInput) keyInput.value = "";
      aiSay("✓ 配置已保存", true);
      paintAiUsage(j.usage);
    } catch {
      aiSay("网络错误，请重试", false);
    }
    window.setTimeout(() => aiStatus?.classList.add("hidden"), 4000);
  });

  document.getElementById("ai-test")?.addEventListener("click", async () => {
    aiSay("正在测试连接…", true);
    try {
      const res = await fetch("/api/admin/ai/test", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(collectAi()),
      });
      const j = await res.json();
      if (!j.ok) {
        aiSay(`连接失败：${j.error ?? "未知错误"}`, false);
        return;
      }
      aiSay(
        `✓ 可达（${j.latencyMs}ms）· prompt ${j.promptTokens} / completion ${j.completionTokens} ${
          j.estimated ? "（估算）" : "（接口真实值）"
        } · 返回：${j.summary || "(空)"}`,
        true
      );
      // 探测也会记一次调用，顺带回传最新用量把面板刷新掉
      const cfgRes = await fetch("/api/admin/ai/config");
      const cfgJson = await cfgRes.json();
      if (cfgJson?.usage) paintAiUsage(cfgJson.usage);
    } catch {
      aiSay("网络错误，请重试", false);
    }
    window.setTimeout(() => aiStatus?.classList.add("hidden"), 6000);
  });
</script>
