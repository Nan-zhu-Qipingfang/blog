---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconGallery from "@/assets/icons/IconGallery.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import logoLeftLight from "@/assets/logo/nanzhu-left-light.png";
import logoRightLight from "@/assets/logo/nanzhu-right-light.png";
import logoLeftDark from "@/assets/logo/nanzhu-left-dark.png";
import logoRightDark from "@/assets/logo/nanzhu-right-dark.png";
import LinkButton from "./LinkButton.astro";
import MobileMenu from "./MobileMenu.astro";
import IntroAudioCompact from "./IntroAudioCompact.astro";
import PortalNav from "./PortalNav.astro";
import ConsolePanel from "./ConsolePanel.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 rounded-b-lg bg-accent px-4 py-2 font-medium text-background transition-all focus:top-0"
>
  跳转到内容
</a>

<header id="main-header" class="sticky top-0 z-40 w-full transition-colors duration-300">
  <div class="header-scrolled-filter w-full">
    <div class="app-layout">
      <div
        id="top-nav-wrap"
        class:list={[
          "py-3 sm:py-5",
          "relative w-full",
          "flex items-center justify-between gap-2 sm:gap-4",
          "transition-all duration-300",
        ]}
      >
        <!-- Fingerprint quick-nav (云盘/相册, admin-configurable) + logo, kept adjacent -->
        <div class="flex shrink-0 items-center">
          <PortalNav />

          <!-- Logo (NANZHU, split pieces reuse the original logo hover animations) -->
          <a
            href="/"
            class="logo-link group relative z-20 flex items-center gap-2 text-xl font-bold tracking-tight sm:text-2xl"
          >
            <span class="logo-ripple" aria-hidden="true"></span>
            <span class="flex items-center">
              <span class="logo-sphere logo-rabbit inline-flex">
                <img
                  src={logoLeftLight.src}
                  alt="NANZHU 七平方工作室"
                  class="logo-text-left h-10 sm:h-11 w-auto dark:hidden"
                  width="206"
                  height="160"
                />
                <img
                  src={logoLeftDark.src}
                  alt=""
                  aria-hidden="true"
                  class="logo-text-left hidden h-10 sm:h-11 w-auto dark:block"
                  width="206"
                  height="160"
                />
              </span>
              <img
                src={logoRightLight.src}
                alt=""
                aria-hidden="true"
                class="logo-text-right h-10 sm:h-11 w-auto dark:hidden"
                width="283"
                height="160"
              />
              <img
                src={logoRightDark.src}
                alt=""
                aria-hidden="true"
                class="logo-text-right hidden h-10 sm:h-11 w-auto dark:block"
                width="283"
                height="160"
              />
            </span>
          </a>
        </div>

        <!-- Center Audio Player -->
        {
          SITE.introAudio.enabled && (
            <div class="flex-1 flex justify-center min-w-0">
              <IntroAudioCompact
                src={SITE.introAudio.src}
                label={SITE.introAudio.label}
                duration={SITE.introAudio.duration}
                isStream={SITE.introAudio.isStream}
                class="nav-intro-audio-compact"
              />
            </div>
          )
        }

        <!-- Nav area -->
        <nav id="nav-menu" class="flex items-center sm:gap-1 shrink-0">
          <!-- Mobile hamburger (animated lines) -->
          <button
            id="menu-btn"
            class="hamburger-btn sm:hidden"
            aria-label="打开菜单"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <div class="hamburger-box">
              <span class="hamburger-line hamburger-line--1"></span>
              <span class="hamburger-line hamburger-line--2"></span>
              <span class="hamburger-line hamburger-line--3"></span>
            </div>
          </button>

          <!-- Desktop links (always visible on sm+) -->
          <ul class="hidden sm:flex sm:flex-row sm:items-center sm:gap-1 relative" data-glide-nav>
            <!-- Shared hover pill, position driven by runtime (glide effect) -->
            <li class="glide-pill" data-glide-pill aria-hidden="true"></li>
            <li>
              <a
                href="/posts"
                class:list={["nav-link", { "nav-active": isActive("/posts") }]}
                >文章</a
              >
            </li>
            <li>
              <a
                href="/tags"
                class:list={["nav-link", { "nav-active": isActive("/tags") }]}
                >标签</a
              >
            </li>
            <li>
              <a
                href="/about"
                class:list={["nav-link", { "nav-active": isActive("/about") }]}
                >关于</a
              >
            </li>
            {
              SITE.showArchives && (
                <li>
                  <LinkButton
                    href="/archives"
                    class:list={[
                      "nav-link",
                      { "nav-active": isActive("/archives") },
                    ]}
                    title="归档"
                    aria-label="归档"
                  >
                    <IconArchive class="hidden sm:inline-block" />
                    <span class="sm:sr-only">归档</span>
                  </LinkButton>
                </li>
              )
            }
            {
              SITE.showGalleries && (
                <li>
                  <LinkButton
                    href="/galleries"
                    class:list={[
                      "nav-link",
                      { "nav-active": isActive("/galleries") },
                    ]}
                    title="相册"
                    aria-label="相册"
                  >
                    <IconGallery class="hidden sm:inline-block" />
                    <span class="sm:sr-only">相册</span>
                  </LinkButton>
                </li>
              )
            }

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <li class="flex items-center">
              <button
                data-search-trigger
                class="nav-search-btn"
                title="搜索 (⌘K)"
                aria-label="打开搜索"
                aria-keyshortcuts="Meta+K"
              >
                <IconSearch class="size-4.5" />
                <kbd class="nav-kbd">⌘K</kbd>
              </button>
            </li>
            {
              SITE.lightAndDarkMode && (
                <li class="flex items-center">
                  <button
                    id="theme-btn"
                    class="nav-icon-btn relative"
                    title="切换明暗模式"
                    aria-label="auto"
                    aria-live="polite"
                  >
                    <IconMoon class="absolute top-1/2 left-1/2 -translate-1/2 scale-100 rotate-0 transition-all duration-300 dark:scale-0 dark:-rotate-90" />
                    <IconSunHigh class="absolute top-1/2 left-1/2 -translate-1/2 scale-0 rotate-90 transition-all duration-300 dark:scale-100 dark:rotate-0" />
                  </button>
                </li>
              )
            }
            <li class="flex items-center">
              <ConsolePanel />
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
  <MobileMenu currentPath={currentPath} />

  <!-- Bottom border with gradient -->
  <div
    id="header-border"
    class="header-border-line opacity-0 transition-opacity duration-300 h-px w-full bg-linear-to-r from-transparent via-border/40 to-transparent"
  >
  </div>
</header>

<style>
  /* ─── Header Glass & Scroll Physics ─── */
  #main-header {
    background: transparent;
  }
  
  /* 滚动后：整条顶栏变成一块"悬浮的液态玻璃圆角条"，
     底部大圆角 + 高饱和模糊 + 顶部折射高光，对齐 iOS 系统栏观感 */
  :global(.header-scrolled) {
    background: transparent !important;
    box-shadow: none;
  }

  :global(.header-scrolled .header-scrolled-filter) {
    position: relative;
    background: var(--glass-tint-strong);
    backdrop-filter: blur(var(--glass-blur-lg)) saturate(var(--glass-sat));
    -webkit-backdrop-filter: blur(var(--glass-blur-lg)) saturate(var(--glass-sat));
    border: 1px solid var(--glass-border);
    border-top: 0;
    border-radius: 0 0 var(--radius-panel) var(--radius-panel);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      0 10px 30px -16px color-mix(in srgb, var(--foreground) 45%, transparent);
    transition:
      background-color 0.3s ease,
      border-radius 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* 顶栏玻璃条的折射描边（与 .glass-specular 同思路，但只在底部两侧） */
  :global(.header-scrolled .header-scrolled-filter)::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      180deg,
      var(--glass-highlight) 0%,
      rgba(255, 255, 255, 0) 45%,
      rgba(255, 255, 255, 0) 70%,
      color-mix(in srgb, var(--glass-highlight) 40%, transparent) 100%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }

  .nav-logo-text {
    background: linear-gradient(
      135deg,
      var(--foreground) 0%,
      var(--foreground) 60%,
      var(--accent) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :global(.nav-intro-audio-compact) {
    max-width: 100%;
  }

  /* ─── Logo：柔和悬停 / 按下反馈 / 点击起跳 ─── */
  .logo-link {
    position: relative;
    -webkit-tap-highlight-color: transparent;
    /* 松手用回弹曲线归位；按下时下面换成更快的 ease-out */
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  /* 按下瞬间快速下沉，避免"点下去毫无反应"的生硬感 */
  .logo-link:active {
    transform: scale(0.94);
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
  }
  .logo-link:focus-visible {
    outline: none;
  }
  .logo-link:focus-visible .logo-ripple {
    opacity: 0.45;
    transform: scale(1);
  }

  :global(.logo-text-left),
  :global(.logo-text-right) {
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s ease;
  }
  :global(.logo-sphere) {
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.4s ease;
    transform-origin: 50% 62%;
  }
  /* 兔子那一片按自身身体重心摆动 */
  .logo-rabbit {
    transform-origin: 30% 62%;
  }

  /* 悬停：轻微分离 + 极缓呼吸（不再是一次性硬抖） */
  .logo-link:hover :global(.logo-text-left) {
    transform: translateX(-4px) rotate(-1.2deg);
    filter: drop-shadow(0 1px 5px color-mix(in srgb, var(--accent) 35%, transparent));
  }
  .logo-link:hover :global(.logo-text-right) {
    transform: translateX(4px) rotate(1.2deg);
    filter: drop-shadow(0 1px 5px color-mix(in srgb, var(--accent) 35%, transparent));
  }
  .logo-link:hover :global(.logo-sphere) {
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--accent) 45%, transparent));
    animation: logo-breathe 1.8s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes logo-breathe {
    0%,
    100% {
      transform: rotate(-2.5deg) scale(1);
    }
    50% {
      transform: rotate(2.5deg) scale(1.045);
    }
  }

  /* 点击：一圈涟漪从标识中心散开（双层错峰） */
  .logo-ripple {
    position: absolute;
    left: 6%;
    top: 50%;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: -1.25rem;
    border-radius: 9999px;
    border: 1.5px solid color-mix(in srgb, var(--accent) 55%, transparent);
    opacity: 0;
    transform: scale(0.4);
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .logo-ripple::after {
    content: "";
    position: absolute;
    inset: -0.35rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .logo-link.is-launching .logo-ripple {
    animation: logo-ripple 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .logo-link.is-launching .logo-ripple::after {
    animation: logo-ripple 0.72s cubic-bezier(0.22, 1, 0.36, 1) 0.12s;
  }

  @keyframes logo-ripple {
    0% {
      opacity: 0.7;
      transform: scale(0.35);
    }
    70% {
      opacity: 0.16;
    }
    100% {
      opacity: 0;
      transform: scale(2.2);
    }
  }

  /* 点击：兔子蓄力压扁 → 弹起拉伸 → 落回带余震
     breathe 放在前面、hop 放后面：hop 期间覆盖呼吸，结束后自然接回呼吸 */
  .logo-link.is-launching :global(.logo-sphere) {
    animation:
      logo-breathe 1.8s cubic-bezier(0.45, 0, 0.55, 1) infinite,
      logo-hop 0.66s cubic-bezier(0.33, 1, 0.68, 1);
  }
  @keyframes logo-hop {
    0% {
      transform: translateY(0) scale(1, 1);
    }
    16% {
      transform: translateY(2px) scale(1.14, 0.85);
    }
    44% {
      transform: translateY(-7px) scale(0.93, 1.13) rotate(-5deg);
    }
    66% {
      transform: translateY(1.5px) scale(1.09, 0.91) rotate(2.5deg);
    }
    85% {
      transform: translateY(-2px) scale(0.97, 1.04) rotate(-1.2deg);
    }
    100% {
      transform: translateY(0) scale(1, 1) rotate(0deg);
    }
  }

  /* 点击：两侧文字先向内吸气、再弹开、最后柔和归位（anticipation → overshoot → settle） */
  .logo-link.is-launching :global(.logo-text-left) {
    animation: logo-part-left 0.66s cubic-bezier(0.33, 1, 0.68, 1);
  }
  .logo-link.is-launching :global(.logo-text-right) {
    animation: logo-part-right 0.66s cubic-bezier(0.33, 1, 0.68, 1);
  }
  @keyframes logo-part-left {
    0% {
      transform: translateX(0) rotate(0deg);
    }
    20% {
      transform: translateX(2px) rotate(1deg);
    }
    48% {
      transform: translateX(-9px) rotate(-2.2deg);
    }
    74% {
      transform: translateX(-3px) rotate(-0.6deg);
    }
    100% {
      transform: translateX(0) rotate(0deg);
    }
  }
  @keyframes logo-part-right {
    0% {
      transform: translateX(0) rotate(0deg);
    }
    20% {
      transform: translateX(-2px) rotate(-1deg);
    }
    48% {
      transform: translateX(9px) rotate(2.2deg);
    }
    74% {
      transform: translateX(3px) rotate(0.6deg);
    }
    100% {
      transform: translateX(0) rotate(0deg);
    }
  }

  /* ─── Glide pill: shared hover background that slides between items ─── */
  .glide-pill {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0;
    height: 2rem;
    margin-top: -1rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 4px 14px -6px color-mix(in srgb, var(--accent) 60%, transparent);
    transition:
      transform 0.35s cubic-bezier(0.34, 1.3, 0.64, 1),
      width 0.35s cubic-bezier(0.34, 1.3, 0.64, 1),
      opacity 0.25s ease;
  }

  /* 静止时停在“当前页”上，鼠标移入其它项再滑过去（对标 liushen 的导航指示） */
  .glide-pill.resting {
    opacity: 1;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .glide-pill.visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .glide-pill {
      transition: opacity 0.2s ease;
    }

    /* Logo：关掉位移/弹跳，只保留极轻的透明度反馈 */
    .logo-link {
      transition: opacity 0.2s ease;
    }
    .logo-link:active {
      transform: none;
      opacity: 0.65;
      transition-duration: 0.12s;
    }
    .logo-link:hover :global(.logo-sphere),
    .logo-link.is-launching :global(.logo-sphere),
    .logo-link.is-launching :global(.logo-text-left),
    .logo-link.is-launching :global(.logo-text-right),
    .logo-link.is-launching .logo-ripple,
    .logo-link.is-launching .logo-ripple::after {
      animation: none;
    }
    .logo-link:hover :global(.logo-text-left),
    .logo-link:hover :global(.logo-text-right) {
      transform: none;
    }
  }

  /* ─── Desktop nav links ─── */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 9999px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  /* 首屏逐项入场 */
  @media (min-width: 640px) {
    [data-glide-nav] > li:not(.glide-pill) {
      animation: nav-item-in 0.4s cubic-bezier(0.34, 1.3, 0.64, 1) both;
    }
    [data-glide-nav] > li:nth-child(2) { animation-delay: 0.04s; }
    [data-glide-nav] > li:nth-child(3) { animation-delay: 0.08s; }
    [data-glide-nav] > li:nth-child(4) { animation-delay: 0.12s; }
    [data-glide-nav] > li:nth-child(5) { animation-delay: 0.16s; }
    [data-glide-nav] > li:nth-child(6) { animation-delay: 0.2s; }
    [data-glide-nav] > li:nth-child(7) { animation-delay: 0.24s; }
    [data-glide-nav] > li:nth-child(8) { animation-delay: 0.28s; }
    [data-glide-nav] > li:nth-child(n + 9) { animation-delay: 0.32s; }
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .nav-link:focus-visible, .nav-icon-btn:focus-visible, .nav-search-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  :is(.nav-link, .nav-icon-btn):hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    transform: translateY(-1px);
  }

  .nav-active {
    color: var(--accent);
    /* Clean active state for desktop */
    background: transparent;
  }

  /* Glowing dot for active state (macOS Dock style) */
  .nav-active::after {
    content: "";
    position: absolute;
    bottom: -0.1rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .nav-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    transition: color 0.2s ease, background-color 0.2s ease;
    color: var(--foreground);
  }

  /* ─── Desktop Search Button with ⌘K ─── */
  .nav-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.5rem 0.3rem 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted-foreground);
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.25s ease,
      transform 0.25s cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  .nav-search-btn:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -12px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .nav-kbd {
    display: inline-flex;
    align-items: center;
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-bottom-width: 2px;
    background: color-mix(in srgb, var(--background) 90%, transparent);
    color: var(--muted-foreground);
    box-shadow: inset 0 -1px 0 rgba(0,0,0,0.1);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .nav-search-btn:hover .nav-kbd {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }

  /* ─── Animated Hamburger Button ─── */
  .hamburger-btn {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    border: 1px solid transparent;
    background: transparent;
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .hamburger-btn {
      display: none;
    }
  }

  .hamburger-btn:hover,
  .hamburger-btn[aria-expanded="true"] {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .hamburger-box {
    position: relative;
    width: 18px;
    height: 14px;
  }

  .hamburger-line {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--foreground);
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      top 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hamburger-line--1 {
    top: 0;
  }
  .hamburger-line--2 {
    top: 6px;
  }
  .hamburger-line--3 {
    top: 12px;
    width: 60%;
  }

  /* Open state: morph to X */
  .hamburger-btn[aria-expanded="true"] .hamburger-line {
    background: var(--accent);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--1 {
    top: 6px;
    transform: rotate(45deg);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--3 {
    top: 6px;
    width: 100%;
    transform: rotate(-45deg);
  }


</style>

<script>
  let headerCleanup: AbortController | null = null;
  let scrollCleanup: AbortController | null = null;
  let logoCleanup: AbortController | null = null;

  function setupScrollPhysics() {
    if (scrollCleanup) scrollCleanup.abort();
    scrollCleanup = new AbortController();
    const { signal } = scrollCleanup;

    const header = document.getElementById("main-header");
    const navWrap = document.getElementById("top-nav-wrap");
    const borderLine = document.getElementById("header-border");

    if (!header || !navWrap || !borderLine) return;

    let rafPending = false;
    const handleScroll = () => {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 15;
        header.classList.toggle("header-scrolled", scrolled);
        navWrap.classList.toggle("sm:py-5", !scrolled);
        navWrap.classList.toggle("sm:py-3", scrolled);
        borderLine.classList.toggle("opacity-0", !scrolled);
        borderLine.classList.toggle("opacity-100", scrolled);
        rafPending = false;
      });
    };

    window.addEventListener("scroll", handleScroll, { passive: true, signal });
    handleScroll(); // Init instantly
  }

  function setupMobileNav() {
    // Cleanup previous listeners
    if (headerCleanup) headerCleanup.abort();
    headerCleanup = new AbortController();
    const { signal } = headerCleanup;

    const menuBtn = document.querySelector("#menu-btn");
    const mobileMenu = document.querySelector("#mobile-menu");
    const backdrop = document.querySelector(".mobile-menu-backdrop");

    if (!menuBtn || !mobileMenu) return;
    
    const closeMenu = () => {
      menuBtn.setAttribute("aria-expanded", "false");
      menuBtn.setAttribute("aria-label", "打开菜单");
      mobileMenu.classList.remove("is-open");
      mobileMenu.setAttribute("aria-hidden", "true");
    };

    menuBtn.addEventListener(
      "click",
      () => {
        const isOpen = menuBtn.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          closeMenu();
        } else {
          menuBtn.setAttribute("aria-expanded", "true");
          menuBtn.setAttribute("aria-label", "关闭菜单");
          mobileMenu.classList.add("is-open");
          mobileMenu.setAttribute("aria-hidden", "false");
        }
      },
      { signal }
    );
    
    // Close when clicking the backdrop
    if (backdrop) {
      backdrop.addEventListener("click", closeMenu, { signal });
      window.addEventListener("scroll", closeMenu, { passive: true, signal });
    }

    // Close mobile menu on link click
    mobileMenu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", closeMenu, { signal });
    });
  }

  function setupGlidePill() {
    const nav = document.querySelector<HTMLElement>("[data-glide-nav]");
    const pill = nav?.querySelector<HTMLElement>("[data-glide-pill]");
    if (!nav || !pill) return;

    const links = Array.from(nav.querySelectorAll<HTMLElement>(".nav-link"));
    if (links.length === 0) return;
    const active = nav.querySelector<HTMLElement>(".nav-link.nav-active");

    const moveTo = (link: HTMLElement) => {
      pill.style.width = `${link.offsetWidth}px`;
      pill.style.transform = `translateX(${link.offsetLeft}px)`;
    };

    /** 回到“当前页”所在的项：有激活项就常驻显示，否则隐藏 */
    const restOnActive = () => {
      if (active) {
        moveTo(active);
        pill.classList.add("resting");
        pill.classList.remove("visible");
      } else {
        pill.classList.remove("resting", "visible");
      }
    };

    links.forEach(link => {
      const highlight = () => {
        moveTo(link);
        pill.classList.add("visible");
        pill.classList.remove("resting");
      };
      link.addEventListener("mouseenter", highlight);
      link.addEventListener("focus", highlight);
    });

    nav.addEventListener("mouseleave", restOnActive);
    nav.addEventListener("focusout", restOnActive);

    // 视口变化后偏移量会变，需要重算
    window.addEventListener("resize", () => {
      const hovered = nav.querySelector<HTMLElement>(".nav-link:hover");
      if (hovered) moveTo(hovered);
      else restOnActive();
    });

    // Resting position on the active item — now visible by default
    if (getComputedStyle(nav).display !== "none") {
      pill.style.transition = "none";
      restOnActive();
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          pill.style.transition = "";
        });
      });
    }
  }

  /**
   * Logo 点击动效：
   * 1) 按下由 CSS :active 负责（快速下沉，松手回弹）
   * 2) 松手后播放一次「蓄力 → 弹起 → 落回」+ 涟漪
   * 3) 已经在首页时不再硬跳刷新，改为平滑回到顶部
   */
  function setupLogoLaunch() {
    if (logoCleanup) logoCleanup.abort();
    logoCleanup = new AbortController();
    const { signal } = logoCleanup;

    const logo = document.querySelector<HTMLElement>(".logo-link");
    if (!logo) return;

    const LAUNCH_MS = 720;
    let timer = 0;

    const play = () => {
      logo.classList.remove("is-launching");
      // 强制重排，保证连点时动画能重新播放
      void logo.offsetWidth;
      logo.classList.add("is-launching");
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        logo.classList.remove("is-launching");
      }, LAUNCH_MS);
    };

    logo.addEventListener(
      "click",
      event => {
        // 新标签页打开 / 中键 / 右键：交给浏览器，不放动画
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          return;

        play();

        // 当前就在首页：避免"点一下硬跳刷新"，改成柔和回到顶部
        const path = location.pathname.replace(/\/+$/, "");
        const isHome = path === "" || path === "/index.html";
        if (!isHome) return;

        event.preventDefault();
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      },
      { signal }
    );

    // 键盘触发（Enter）同样给一次反馈
    logo.addEventListener(
      "keydown",
      event => {
        if (event.key === "Enter" || event.key === " ") play();
      },
      { signal }
    );
  }

  // Initial load
  setupScrollPhysics();
  setupMobileNav();
  setupGlidePill();
  setupLogoLaunch();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", () => {
    setupScrollPhysics();
    setupMobileNav();
    setupGlidePill();
    setupLogoLaunch();
  });
</script>
