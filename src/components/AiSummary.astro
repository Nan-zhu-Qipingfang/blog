---
/**
 * AI summary card — iOS / macOS window style (对标参考站 ai-summary-card).
 *
 * Structure mirrors the reference layout:
 *   .ai-summary-card
 *     └ .ai-summary-glow      (blurred colour halo behind the surface)
 *       └ .ai-summary-surface (frosted panel with traffic-light head)
 *           ├ .ai-summary-head    (red / yellow / green dots + actions)
 *           ├ .ai-summary-text    (typewriter output + blinking caret)
 *           └ .ai-summary-footer  (wand brand + model badge)
 */
export interface Props {
  summary?: string;
}
const { summary } = Astro.props;
const text = (summary ?? "").trim();
const brand = "七平方AI";
---

{
  text && (
    <section
      id="ai-summary"
      class="ai-summary-card mx-auto mt-8 w-full max-w-app"
      data-pagefind-ignore
      aria-label="AI 摘要"
    >
      {/* 背后的彩色光晕 */}
      <div class="ai-summary-glow" aria-hidden="true"></div>

      <div class="ai-summary-surface">
        {/* 标题栏：macOS 三色点 */}
        <div class="ai-summary-head">
          <span class="ai-summary-dot ai-summary-dot-red" aria-hidden="true"></span>
          <span class="ai-summary-dot ai-summary-dot-yellow" aria-hidden="true"></span>
          <span class="ai-summary-dot ai-summary-dot-green" aria-hidden="true"></span>

          <span class="ai-summary-status" data-ai-status>
            已生成
          </span>

          <button
            type="button"
            id="ai-refresh"
            class="ai-summary-action"
            title="重看一遍（不重复调用接口）"
            aria-label="重新播放摘要动画"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12a9 9 0 1 1-2.64-6.36" />
              <path d="M21 3v6h-6" />
            </svg>
          </button>
        </div>

        {/* 摘要正文：打字机 */}
        <p
          class="ai-summary-text"
          data-ai-text
          data-full={text}
        />

        {/* 页脚：品牌 + 模型 */}
        <div class="ai-summary-footer">
          <span class="ai-summary-brand">
            <svg
              class="ai-summary-brand-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m14.5 3.5 1.2 3.1 3.1 1.2-3.1 1.2-1.2 3.1-1.2-3.1L10.2 7.8l3.1-1.2z" />
              <path d="M4.8 13.4l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" />
              <path d="M14.6 16.2l.6 1.5 1.5.6-1.5.6-.6 1.5-.6-1.5-1.5-.6 1.5-.6z" />
            </svg>
            <span>AI 摘要</span>
          </span>
          <span class="ai-summary-model">{brand}</span>
        </div>
      </div>
    </section>
  )
}

<style>
  .ai-summary-card {
    position: relative;
    isolation: isolate;
    --ai-radius: 1.15rem;
  }

  /* ── 背景光晕 ───────────────────────────────────────── */
  .ai-summary-glow {
    z-index: -1;
    background:
      radial-gradient(
        circle at 12% 20%,
        color-mix(in srgb, var(--accent) 30%, transparent),
        transparent 34%
      ),
      radial-gradient(circle at 88% 18%, color-mix(in srgb, var(--muted) 45%, transparent), transparent 36%),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent) 20%, transparent),
        color-mix(in srgb, var(--muted) 20%, transparent)
      );
    filter: blur(15px);
    opacity: 0.4;
    border-radius: var(--ai-radius);
    position: absolute;
    inset: 0.25rem;
    transform: translateY(3px) scale(0.985);
  }

  /* ── 玻璃面板 ───────────────────────────────────────── */
  .ai-summary-surface {
    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--background) 92%, white 8%),
        color-mix(in srgb, var(--background) 88%, var(--accent) 8%)
      ),
      radial-gradient(circle at 8% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 38%),
      radial-gradient(circle at 94% 100%, color-mix(in srgb, var(--muted) 12%, transparent), transparent 40%);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--foreground) 8%, transparent),
      0 18px 44px -34px color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: var(--ai-radius);
    position: relative;
    overflow: hidden;
  }

  /* ── 标题栏 + 三色点 ────────────────────────────────── */
  .ai-summary-head {
    gap: 0.45rem;
    padding: 0.75rem 0.85rem 0.25rem;
    display: flex;
    align-items: center;
  }

  .ai-summary-dot {
    border-radius: 999px;
    width: 0.62rem;
    height: 0.62rem;
    box-shadow: inset 0 1px rgb(255 255 255 / 38%);
    flex: none;
  }
  .ai-summary-dot-red {
    background: #fc625d;
  }
  .ai-summary-dot-yellow {
    background: #fdbc40;
  }
  .ai-summary-dot-green {
    background: #35cd4b;
  }

  .ai-summary-status {
    margin-left: 0.35rem;
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: opacity 0.3s ease;
  }

  .ai-summary-action {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: none;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--foreground) 6%, transparent);
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }
  .ai-summary-action:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }
  .ai-summary-action:active {
    transform: scale(0.92);
  }

  /* ── 正文 ───────────────────────────────────────────── */
  .ai-summary-text {
    min-height: 3.2rem;
    color: color-mix(in srgb, var(--foreground) 85%, transparent);
    letter-spacing: 0.01em;
    text-align: justify;
    margin: 0;
    padding: 0.6rem 1rem 0.75rem;
    font-size: 0.96rem;
    line-height: 1.72;
    word-break: break-word;
  }
  /* 打字光标 */
  .ai-summary-text::after {
    content: "";
    display: inline-block;
    vertical-align: baseline;
    width: 0.5rem;
    height: 0.13rem;
    margin-left: 0.18rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--foreground) 70%, transparent);
    opacity: 0;
  }
  .ai-summary-text.typing::after {
    opacity: 1;
    width: 0.28rem;
    height: 0.95em;
    animation: ai-summary-cursor 1s ease-in-out infinite;
  }
  @keyframes ai-summary-cursor {
    0%,
    to {
      opacity: 1;
    }
    50% {
      opacity: 0.1;
    }
  }

  /* ── 页脚 ───────────────────────────────────────────── */
  .ai-summary-footer {
    color: color-mix(in srgb, var(--foreground) 48%, transparent);
    letter-spacing: 0.02em;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0 1rem 0.8rem;
    font-size: 0.875rem;
    font-weight: 600;
    display: flex;
  }

  .ai-summary-brand {
    align-items: center;
    gap: 0.38rem;
    min-width: 0;
    display: inline-flex;
  }
  .ai-summary-brand-icon {
    width: 0.95rem;
    height: 0.95rem;
    color: color-mix(in srgb, var(--accent) 65%, transparent);
    flex: none;
  }
  .ai-summary-model {
    color: color-mix(in srgb, var(--foreground) 45%, transparent);
    flex: none;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--foreground) 6%, transparent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* ── 动画：打字完成时的一次性光环 ───────────────────── */
  .ai-summary-card.done .ai-summary-surface {
    animation: ai-done-glow 1s ease-out;
  }
  @keyframes ai-done-glow {
    0% {
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, var(--foreground) 8%, transparent),
        0 18px 44px -34px color-mix(in srgb, var(--accent) 60%, transparent),
        0 0 0 0 color-mix(in srgb, var(--accent) 38%, transparent);
    }
    100% {
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, var(--foreground) 8%, transparent),
        0 18px 44px -34px color-mix(in srgb, var(--accent) 60%, transparent),
        0 0 0 16px transparent;
    }
  }

  /* 三色点的轻微呼吸 */
  .ai-summary-card:not(.done) .ai-summary-dot {
    animation: ai-dot-breathe 3.2s ease-in-out infinite;
  }
  .ai-summary-dot-yellow {
    animation-delay: 0.25s !important;
  }
  .ai-summary-dot-green {
    animation-delay: 0.5s !important;
  }
  @keyframes ai-dot-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  /* ── 窄屏 ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .ai-summary-glow {
      filter: blur(11px);
      inset: 0.15rem;
    }
    .ai-summary-head {
      padding: 0.65rem 0.75rem 0.15rem;
    }
    .ai-summary-text {
      min-height: 2.8rem;
      padding: 0.5rem 0.75rem 0.65rem;
      font-size: 0.9375rem;
      line-height: 1.64;
    }
    .ai-summary-footer {
      padding: 0 0.75rem 0.7rem;
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-summary-text.typing::after {
      animation: none;
    }
    .ai-summary-card:not(.done) .ai-summary-dot {
      animation: none;
    }
    .ai-summary-card.done .ai-summary-surface {
      animation: none;
    }
  }
</style>

<script is:inline data-astro-rerun>
  (function () {
    const root = document.getElementById("ai-summary");
    if (!root) return;
    const textEl = root.querySelector("[data-ai-text]");
    const statusEl = root.querySelector("[data-ai-status]");
    const refreshBtn = root.querySelector("#ai-refresh");
    if (!textEl) return;

    const full = textEl.getAttribute("data-full") || "";
    let timer = null;

    function play(speed) {
      if (timer) clearInterval(timer);
      if (!full) {
        textEl.textContent = "";
        return;
      }
      let i = 0;
      textEl.textContent = "";
      textEl.classList.add("typing");
      root.classList.remove("done");
      if (statusEl) statusEl.textContent = "生成中…";
      timer = setInterval(() => {
        // 标点后稍作停顿，读起来更像真实输出
        const ch = full[i] ?? "";
        const step = /[，。！？、；：,.!?;:]/.test(ch) ? 2 : 3;
        i = Math.min(full.length, i + step);
        textEl.textContent = full.slice(0, i);
        if (i >= full.length) {
          clearInterval(timer);
          timer = null;
          textEl.classList.remove("typing");
          if (statusEl) statusEl.textContent = "✓ 已完成";
          root.classList.add("done");
        }
      }, speed);
    }

    // 滚动进入视口再播放（省电，也更有"现场生成"的味道）
    let started = false;
    const io =
      "IntersectionObserver" in window
        ? new IntersectionObserver(
            entries => {
              if (started) return;
              if (entries.some(e => e.isIntersecting)) {
                started = true;
                io.disconnect();
                play(26);
              }
            },
            { threshold: 0.3 },
          )
        : null;
    if (io) io.observe(root);
    else play(26);

    refreshBtn?.addEventListener("click", () => play(16));
  })();
</script>
