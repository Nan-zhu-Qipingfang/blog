---
/**
 * 给带 data-hls-src 的 <video> 挂上 hls.js。
 *
 * m3u8（HLS）交给 hls.js 转成 MSE 播放：Chrome / Edge / Firefox 都不能原生放
 * HLS（哪怕 canPlayType('application/vnd.apple.mpegurl') 返回 "maybe"）。
 * 这里按需动态 import：文章里没有 HLS 视频时，这段 300KB 左右的解封装器
 * 根本不会被下载。
 */
---

<script>
  let hlsPromise = null;
  const instances = new Set();

  function loadHls() {
    if (!hlsPromise) {
      hlsPromise = import("hls.js").catch(() => null);
    }
    return hlsPromise;
  }

  function fail(video, msg) {
    const box = video.closest(".vg-frame") || video.parentElement;
    if (!box || box.querySelector(".vg-error")) return;
    const tip = document.createElement("div");
    tip.className = "vg-error";
    const text = document.createElement("div");
    text.className = "vg-error-text";
    text.textContent = msg;
    tip.appendChild(text);
    box.appendChild(tip);
  }

  /**
   * hls.js 的错误码一大堆，但真正会让用户犯迷糊的只有两种：源站本身挂了，
   * 或者源站没给 CORS 头导致浏览器拒载。这里把它翻成人话。
   */
  function hlsMessage(data) {
    const details = String(data?.details ?? "");
    const status = data?.response?.status ? `（HTTP ${data.response.status}）` : "";
    if (/manifest/i.test(details)) {
      return `视频源取不到播放列表${status}：链接可能已失效、需要鉴权，或对方站点已停止支持固定链接播放。`;
    }
    if (/cors/i.test(details)) {
      return `视频源跨域被拦截${status}：对方响应头没有 Access-Control-Allow-Origin，浏览器会直接拒载（换支持 CORS 的直链即可）。`;
    }
    if (/parse/i.test(details)) {
      return `视频源返回的不是播放列表${status}（多半是接口返回了一段错误提示，而不是 m3u8）。`;
    }
    if (/timeout/i.test(details)) {
      return `连接视频源超时${status}，请检查网络后重试。`;
    }
    if (/buffer|media/i.test(details)) {
      return "视频流解析失败：可能是编码格式不被当前浏览器支持。";
    }
    return `视频加载失败：${details || "未知错误"}${status}`;
  }

  /** 卡在"已开始加载但一直没出画面"时给出可操作的提示，而不是干等。 */
  const watchTimers = new Set();

  function watchStall(video) {
    const timer = window.setTimeout(() => {
      watchTimers.delete(timer);
      if (video.readyState === 0) {
        fail(video, "视频迟迟没有开始播放：可能是源站限速、网络不通，或该浏览器不支持当前编码。");
      }
    }, 12000);
    watchTimers.add(timer);
  }

  function stopWatch(video) {
    watchTimers.forEach(timer => {
      window.clearTimeout(timer);
      watchTimers.delete(timer);
    });
  }

  async function mount(video) {
    // 用 data 标记而不是 WeakSet：同一个 video 只挂一次，
    // 即使这段脚本被重复注入（多个组件都引用了它）也不会重复 attach
    if (video.dataset.hlsMounted === "1") return;
    video.dataset.hlsMounted = "1";

    const src = video.getAttribute("data-hls-src");
    if (!src) return;

    const mod = await loadHls();
    const Hls = mod && (mod.default || mod);

    // hls.js 优先（hls.js 官方推荐顺序）。
    // 不能先用 canPlayType('application/vnd.apple.mpegurl') 判断：Chromium
    // 系会返回 "maybe"，于是走原生 <video src="*.m3u8">，而 Chromium 的原生
    // 媒体栈解不了 m3u8 —— 表现就是拿到播放列表后报
    // MEDIA_ERR_SRC_NOT_SUPPORTED(4)，黑屏 + 0:00。
    if (Hls && typeof Hls.isSupported === "function" && Hls.isSupported()) {
      const hls = new Hls({ enableWorker: true, lowLatencyMode: false });
      instances.add(hls);
      hls.on(Hls.Events.ERROR, (_evt, data) => {
        if (data && data.fatal) fail(video, hlsMessage(data));
      });
      hls.on(Hls.Events.MANIFEST_PARSED, stopWatch);
      hls.loadSource(src);
      hls.attachMedia(video);
      watchStall(video);
      return;
    }

    // 兜底：hls.js 没加载成功（动态 import 失败 / 老 Safari、iOS 原生）就直接
    // 给 src 让浏览器自己试试。Safari 能原生播且更省电；播不出来时由下面的
    // error 监听出提示，比现在就断言"浏览器不支持"准确得多。
    video.src = src;
    video.addEventListener("error", () =>
      fail(
        video,
        "该视频无法播放：当前浏览器不能直接播放 m3u8（可改用 mp4 直链），或源站不可达。"
      )
    );
  }

  function init() {
    document
      .querySelectorAll("video[data-hls-src]")
      .forEach(video => void mount(video));
  }

  function destroy() {
    stopWatch();
    instances.forEach(hls => {
      try {
        hls.destroy();
      } catch {
        /* noop */
      }
    });
    instances.clear();
  }

  init();
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", destroy);
</script>
